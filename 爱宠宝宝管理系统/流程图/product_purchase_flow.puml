@startuml
!define RECTANGLE class
!define CIRCLE ()
!define DIAMOND diamond
!define ARROW -->

' 商品购买流程
start
:用户登录系统;
:进入商品浏览页面;
:浏览商品列表;
diamond "选择商品" as SelectProduct {
  -> 直接购买;
  -> 加入购物车;
}

if (直接购买) then (是)
  :进入商品详情页;
  :选择商品规格/数量;
  :点击立即购买;
else (否)
  :进入商品详情页;
  :选择商品规格/数量;
  :点击加入购物车;
  :继续购物或进入购物车;
  :进入购物车页面;
  :管理购物车商品;
  :点击结算;
endif

:填写收货地址;
:选择支付方式;
diamond "支付方式" as PaymentMethod {
  -> 微信支付;
  -> 支付宝;
  -> 其他支付方式;
}

:确认订单信息;
:提交订单;
:系统生成订单;
:跳转到支付页面;
:完成支付;
:系统更新订单状态为已支付;
:系统通知用户支付成功;
:店端处理订单;
:商品发货;
:系统更新订单状态为已发货;
:用户确认收货;
:系统更新订单状态为已完成;
:订单流程结束;

stop

@enduml