@startuml
!define RECTANGLE class
!define CIRCLE ()
!define DIAMOND diamond
!define ARROW -->

' 宠物圈发帖流程
start
:用户登录系统;
:进入宠物圈页面;
:点击发布帖子按钮;
:选择发布内容类型;
diamond "内容类型" as ContentType {
  -> 文字;
  -> 图片;
  -> 视频;
}

:填写帖子标题;
:输入帖子内容;

if (选择图片/视频) then (是)
  :上传图片/视频;
  :系统存储文件到云存储;
else (否)
  :跳过文件上传;
endif

:点击发布按钮;
:系统提交帖子信息;
:帖子进入审核状态;
:系统通知用户发帖成功;

' 帖子审核流程
:店端管理员审核帖子;
diamond "审核结果" as AuditResult {
  -> 通过;
  -> 驳回;
  -> 删除;
}

if (审核通过) then (是)
  :帖子发布成功;
  :帖子显示在宠物圈;
else (否)
  if (审核驳回) then (是)
    :系统通知用户帖子被驳回;
    :用户可以修改后重新发布;
  else (否)
    :系统通知用户帖子被删除;
  endif
endif

stop

@enduml