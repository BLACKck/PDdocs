@startuml

skinparam backgroundColor #FFFFFF
skinparam activityFontSize 12
skinparam activityFontStyle bold
skinparam arrowFontSize 10

start
:需求提出;
:需求审核;
diamond "审核结果" as auditResult
auditResult --> "通过" as passed
auditResult --> "拒绝" as rejected

rejected --> :需求修改;
:需求修改; --> :需求提出;

passed --> :采购计划;
:采购计划; --> :供应商选择;
:供应商选择; --> :采购订单创建;
:采购订单创建; --> :订单发送;
:订单发送; --> :供应商确认;
:供应商确认; --> :货物接收;
:货物接收; --> :质量检验;
diamond "检验结果" as inspectResult
inspectResult --> "合格" as qualified
inspectResult --> "不合格" as unqualified

unqualified --> :退货处理;
:退货处理; --> :供应商确认;

qualified --> :入库;
:入库; --> :付款;
:付款; --> :采购完成;

stop

@enduml