@startuml

' 宠物信息管理模块流程图
' 宠宝贝应用后端管理系统

title 宠物信息管理模块流程图

actor "管理员" as Admin

start
:管理员登录;
:进入宠物信息管理页面;

if (操作选择) then (审核宠物信息)
  :查看待审核宠物列表;
  :选择宠物;
  :查看宠物详情;
  
  if (审核结果) then (通过)
    :设置审核状态为已通过;
  else (拒绝)
    :设置审核状态为已拒绝;
    :填写拒绝原因;
  endif
  
  :审核完成;
  :返回待审核宠物列表;
else if (查询宠物信息)
  :输入查询条件;
  :点击查询按钮;
  :查看查询结果;
  :返回宠物信息管理页面;
else (统计宠物信息)
  :选择统计维度;
  :点击统计按钮;
  :查看统计结果;
  :导出统计报告;
  :返回宠物信息管理页面;
endif

stop

' 样式设置
skinparam backgroundColor white
skinparam actorStyle awesome
skinparam nodeStyle rectangle
skinparam arrowColor #333333

@enduml