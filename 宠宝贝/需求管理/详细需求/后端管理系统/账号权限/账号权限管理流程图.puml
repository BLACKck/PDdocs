@startuml

' 账号权限管理模块流程图
' 宠宝贝应用后端管理系统

title 账号权限管理模块流程图

actor "管理员" as Admin

start
:管理员登录;
:进入账号权限管理页面;

if (操作选择) then (用户账号管理)
  if (操作类型) then (添加用户)
    :点击添加用户按钮;
    :填写用户信息;
    :设置初始密码;
    :保存用户信息;
    :用户创建成功;
  else if (编辑用户)
    :选择用户;
    :点击编辑按钮;
    :修改用户信息;
    :保存用户信息;
    :用户信息更新成功;
  else (删除用户)
    :选择用户;
    :点击删除按钮;
    :确认删除;
    :用户删除成功;
  endif
  :返回用户账号管理页面;
else if (权限管理)
  :选择用户;
  :点击权限设置按钮;
  :分配角色;
  :设置具体权限;
  :保存权限设置;
  :权限设置成功;
  :返回账号权限管理页面;
else (登录日志)
  :查看登录日志列表;
  :输入查询条件;
  :点击查询按钮;
  :查看查询结果;
  :导出登录日志;
  :返回账号权限管理页面;
endif

stop

' 样式设置
skinparam backgroundColor white
skinparam actorStyle awesome
skinparam nodeStyle rectangle
skinparam arrowColor #333333

@enduml