@startuml

' 商品库存管理模块流程图
' 宠宝贝应用后端管理系统

title 商品库存管理模块流程图

actor "管理员" as Admin

start
:管理员登录;
:进入商品库存管理页面;

if (操作选择) then (商品管理)
  if (操作类型) then (添加商品)
    :点击添加商品按钮;
    :填写商品信息;
    :上传商品图片;
    :设置商品分类;
    :保存商品信息;
    :商品创建成功;
  else if (编辑商品)
    :选择商品;
    :点击编辑按钮;
    :修改商品信息;
    :保存商品信息;
    :商品信息更新成功;
  else (删除商品)
    :选择商品;
    :点击删除按钮;
    :确认删除;
    :商品删除成功;
  endif
  :返回商品管理页面;
else if (库存管理)
  :查看商品库存列表;
  :选择商品;
  :点击库存管理按钮;
  :修改库存数量;
  :设置库存预警;
  :保存库存信息;
  :库存信息更新成功;
  :返回商品库存管理页面;
else (价格管理)
  :选择商品;
  :点击价格管理按钮;
  :设置商品价格;
  :设置促销活动;
  :保存价格信息;
  :价格信息更新成功;
  :返回商品库存管理页面;
endif

stop

' 样式设置
skinparam backgroundColor white
skinparam actorStyle awesome
skinparam nodeStyle rectangle
skinparam arrowColor #333333

@enduml