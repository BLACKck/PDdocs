@startuml
!define RECTANGLE class
!define CIRCLE ()
!define DIAMOND diamond
!define ARROW -->

' 宠物信息管理流程
start
:管理员登录店端管理系统;
:进入宠物信息管理模块;
diamond "选择操作类型" as OperationType {
  -> 宠物档案管理;
  -> 健康记录管理;
  -> 疫苗接种记录管理;
}

' 宠物档案管理
if (宠物档案管理) then (是)
  diamond "选择操作" as PetOperation {
    -> 添加宠物档案;
    -> 编辑宠物档案;
    -> 删除宠物档案;
    -> 查看宠物档案;
  }
  
  if (添加宠物档案) then (是)
    :填写宠物基本信息;
    :上传宠物照片;
    :关联到客户账号;
    :保存宠物档案;
  else (否)
    if (编辑宠物档案) then (是)
      :选择要编辑的宠物档案;
      :修改宠物信息;
      :保存修改;
    else (否)
      if (删除宠物档案) then (是)
        :选择要删除的宠物档案;
        :确认删除;
        :系统删除宠物档案;
      else (否)
        if (查看宠物档案) then (是)
          :选择要查看的宠物档案;
          :查看宠物详细信息;
        endif
      endif
    endif
  endif

' 健康记录管理
elseif (健康记录管理) then (是)
  :选择宠物;
  :查看健康记录列表;
  diamond "选择操作" as HealthOperation {
    -> 添加健康记录;
    -> 编辑健康记录;
    -> 查看健康记录;
  }
  
  if (添加健康记录) then (是)
    :填写就诊日期;
    :填写症状描述;
    :填写诊断结果;
    :填写治疗方案;
    :保存健康记录;
  else (否)
    if (编辑健康记录) then (是)
      :选择要编辑的健康记录;
      :修改健康记录信息;
      :保存修改;
    else (否)
      if (查看健康记录) then (是)
        :选择要查看的健康记录;
        :查看健康记录详情;
      endif
    endif
  endif

' 疫苗接种记录管理
elseif (疫苗接种记录管理) then (是)
  :选择宠物;
  :查看疫苗接种记录列表;
  diamond "选择操作" as VaccineOperation {
    -> 添加疫苗接种记录;
    -> 编辑疫苗接种记录;
    -> 查看疫苗接种记录;
  }
  
  if (添加疫苗接种记录) then (是)
    :选择疫苗类型;
    :填写接种日期;
    :计算下次接种时间;
    :保存疫苗接种记录;
  else (否)
    if (编辑疫苗接种记录) then (是)
      :选择要编辑的疫苗接种记录;
      :修改疫苗接种信息;
      :保存修改;
    else (否)
      if (查看疫苗接种记录) then (是)
        :选择要查看的疫苗接种记录;
        :查看疫苗接种记录详情;
      endif
    endif
  endif

endif

:宠物信息管理流程结束;
stop

@enduml