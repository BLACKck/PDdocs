@startuml

' 宠物商城模块流程图
' 宠宝贝应用H5前端

title 宠物商城模块流程图

actor "用户" as User

start
:用户登录;
:进入宠物商城页面;

if (操作选择) then (浏览商品)
  :查看商品分类;
  :选择分类查看商品;
  :点击商品查看详情;
  
  if (操作选择) then (加入购物车)
    :选择商品数量;
    :点击加入购物车;
    :商品加入购物车成功;
    :返回商品详情;
  else (立即购买)
    :选择商品数量;
    :进入订单确认页面;
  endif
else if (搜索商品)
  :点击搜索框;
  :输入搜索关键词;
  :查看搜索结果;
  :点击商品查看详情;
  
  if (操作选择) then (加入购物车)
    :选择商品数量;
    :点击加入购物车;
    :商品加入购物车成功;
    :返回商品详情;
  else (立即购买)
    :选择商品数量;
    :进入订单确认页面;
  endif
else (购物车)
  :点击购物车按钮;
  :进入购物车页面;
  :选择要购买的商品;
  :点击结算按钮;
  :进入订单确认页面;
endif

if (进入订单确认页面) then (是)
  :填写/选择收货地址;
  :选择支付方式;
  :确认订单信息;
  :点击提交订单;
  :进入支付页面;
  :完成支付;
  :支付成功;
  :订单生成成功;
  :返回宠物商城页面;
endif

stop

' 样式设置
skinparam backgroundColor white
skinparam actorStyle awesome
skinparam nodeStyle rectangle
skinparam arrowColor #333333

@enduml