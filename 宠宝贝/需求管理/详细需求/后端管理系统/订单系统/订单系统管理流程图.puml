@startuml

' 订单系统管理模块流程图
' 宠宝贝应用后端管理系统

title 订单系统管理模块流程图

actor "管理员" as Admin

start
:管理员登录;
:进入订单系统管理页面;

if (操作选择) then (订单处理)
  :查看订单列表;
  :选择订单;
  :查看订单详情;
  
  if (订单状态) then (待支付)
    :点击取消订单按钮;
    :确认取消;
    :订单取消成功;
  else if (待发货)
    :点击发货按钮;
    :填写物流信息;
    :确认发货;
    :订单发货成功;
  else if (待收货)
    :点击确认收货按钮;
    :订单确认收货成功;
  else (退款中)
    :点击处理退款按钮;
    :审核退款申请;
    :确认退款;
    :退款处理成功;
  endif
  
  :订单状态更新;
  :返回订单列表;
else if (订单查询)
  :输入查询条件;
  :点击查询按钮;
  :查看查询结果;
  :导出订单数据;
  :返回订单系统管理页面;
else (订单统计)
  :选择统计维度;
  :点击统计按钮;
  :查看统计结果;
  :导出统计报告;
  :返回订单系统管理页面;
else (物流管理)
  :查看物流信息列表;
  :选择订单;
  :点击物流管理按钮;
  :更新物流信息;
  :保存物流信息;
  :物流信息更新成功;
  :返回订单系统管理页面;
endif

stop

' 样式设置
skinparam backgroundColor white
skinparam actorStyle awesome
skinparam nodeStyle rectangle
skinparam arrowColor #333333

@enduml