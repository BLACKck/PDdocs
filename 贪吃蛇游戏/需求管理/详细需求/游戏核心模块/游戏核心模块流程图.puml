@startuml
' 游戏核心模块流程图
' 贪吃蛇游戏核心模块详细流程

title 游戏核心模块流程图

start
:初始化游戏核心模块;

' 蛇的移动流程
partition "蛇的移动" {
  :获取当前方向;
  :计算新蛇头位置;
  :移动蛇身（尾部移动到新头部位置）;
  :检测方向输入（键盘事件）;
  if (是否反向移动?) then (是)
    :忽略反向输入;
  else (否)
    :更新蛇的移动方向;
  endif
}

' 食物生成流程
partition "食物生成" {
  :生成随机位置;
  if (是否与蛇身重叠?) then (是)
    :重新生成随机位置;
    back to 生成随机位置
  else (否)
    :在该位置生成食物;
  endif
}

' 碰撞检测流程
partition "碰撞检测" {
  :检测蛇头是否超出游戏区域边界;
  if (边界碰撞?) then (是)
    :触发游戏结束;
  else (否)
    :检测蛇头是否与蛇身重叠;
    if (自身碰撞?) then (是)
      :触发游戏结束;
    else (否)
      :检测蛇头是否与食物重叠;
      if (吃到食物?) then (是)
        :增加分数;
        :增加蛇的长度;
        :生成新食物;
      else (否)
        :蛇继续移动;
      endif
    endif
  endif
}

' 分数计算流程
partition "分数计算" {
  :每吃到一个食物，分数增加10分;
  :游戏结束时，比较当前分数与最高分;
  if (当前分数 > 最高分?) then (是)
    :更新最高分为当前分数;
  else (否)
    :保持原最高分;
  endif
}

' 游戏结束流程
partition "游戏结束" {
  :设置游戏状态为"结束";
  :停止蛇的移动;
  :显示游戏结束信息;
  :显示最终得分和最高分;
  :显示重新开始按钮;
}

stop
@enduml