@startuml

skinparam backgroundColor #FFFFFF
skinparam activityFontSize 12
skinparam activityFontStyle bold
skinparam arrowFontSize 10

start
:客户提交请求;
:客服接收工单;
:工单分类;
:工单分配;
:客服处理工单;
diamond "处理结果" as processResult
processResult --> "解决" as resolved
processResult --> "未解决" as unresolved

unresolved --> :升级处理;
:升级处理; --> :高级客服处理;
:高级客服处理; --> :客服处理工单;

resolved --> :工单关闭;
:工单关闭; --> :客户满意度调查;
:客户满意度调查; --> :服务质量分析;

stop

@enduml