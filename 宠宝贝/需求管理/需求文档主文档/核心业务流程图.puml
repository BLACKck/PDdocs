@startuml

' 核心业务流程图
' 宠宝贝应用

title 宠宝贝应用核心业务流程图

' 定义参与者
actor "用户" as User
actor "管理员" as Admin

' 宠物信息管理流程
package "宠物信息管理流程" {
  start
  :用户登录;
  :进入我的宠物页面;
  if (是否有宠物信息) then (是)
    :查看宠物列表;
    :选择宠物;
    :查看宠物详情;
    if (操作选择) then (编辑)
      :编辑宠物信息;
      :保存宠物信息;
      :返回宠物列表;
    else if (删除)
      :删除宠物信息;
      :返回宠物列表;
    else if (健康记录)
      :管理健康记录;
      :返回宠物详情;
    else if (提醒)
      :管理提醒;
      :返回宠物详情;
    else (相册)
      :管理宠物相册;
      :返回宠物详情;
    endif
  else (否)
    :添加宠物信息;
    :填写宠物信息;
    :上传宠物照片;
    :保存宠物信息;
    :返回宠物列表;
  endif
  stop
}

' 动态发布流程
package "动态发布流程" {
  start
  :用户登录;
  :进入宠物广场页面;
  :点击发布按钮;
  :填写动态内容;
  if (是否上传媒体文件) then (是)
    :选择图片/视频;
  endif
  :添加话题标签;
  :发布动态;
  :动态发布成功;
  :返回宠物广场页面;
  stop
}

' 商品购买流程
package "商品购买流程" {
  start
  :用户登录;
  :进入宠物商城页面;
  :浏览商品;
  :查看商品详情;
  if (操作选择) then (加入购物车)
    :商品加入购物车;
    :进入购物车页面;
    :选择商品;
  endif
  :进入订单确认页面;
  :填写收货地址;
  :选择支付方式;
  :确认支付;
  :支付成功;
  :订单生成成功;
  :返回宠物商城页面;
  stop
}

' 宠物信息审核流程
package "宠物信息审核流程" {
  start
  :管理员登录;
  :进入宠物信息管理页面;
  :查看待审核宠物列表;
  :选择宠物;
  :查看宠物详情;
  if (审核结果) then (通过)
    :设置审核状态为已通过;
  else (拒绝)
    :设置审核状态为已拒绝并填写意见;
  endif
  :审核完成;
  :返回待审核宠物列表;
  stop
}

' 订单处理流程
package "订单处理流程" {
  start
  :管理员登录;
  :进入订单系统管理页面;
  :查看订单列表;
  :选择订单;
  :查看订单详情;
  if (订单状态) then (待支付)
    :取消订单;
  else if (待发货)
    :填写物流信息并发货;
  else if (待收货)
    :确认收货;
  else (退款中)
    :处理退款;
  endif
  :订单状态更新;
  :返回订单列表;
  stop
}

' 样式设置
skinparam backgroundColor white
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam nodeStyle rectangle
skinparam arrowColor #333333

@enduml