@startuml

' 宠物广场模块流程图
' 宠宝贝应用H5前端

title 宠物广场模块流程图

actor "用户" as User

start
:用户登录;
:进入宠物广场页面;

if (操作选择) then (发布动态)
  :点击发布按钮;
  :填写动态内容;
  
  if (是否上传媒体文件) then (是)
    :选择图片/视频;
    :上传媒体文件;
  endif
  
  if (是否添加话题标签) then (是)
    :选择/创建话题标签;
  endif
  
  :发布动态;
  :动态发布成功;
  :返回宠物广场页面;
else if (浏览动态)
  :下拉刷新/上拉加载;
  :查看动态列表;
  :点击动态查看详情;
  
  if (是否互动) then (点赞)
    :点击点赞按钮;
    :点赞成功;
  else if (评论)
    :输入评论内容;
    :发布评论;
    :评论成功;
  else if (关注)
    :点击关注按钮;
    :关注成功;
  endif
  
  :返回宠物广场页面;
else (搜索)
  :点击搜索按钮;
  :输入搜索关键词;
  :查看搜索结果;
  :返回宠物广场页面;
endif

stop

' 样式设置
skinparam backgroundColor white
skinparam actorStyle awesome
skinparam nodeStyle rectangle
skinparam arrowColor #333333

@enduml