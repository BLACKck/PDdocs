@startuml
!define RECTANGLE class
!define CIRCLE ()
!define DIAMOND diamond
!define ARROW -->

' 订单处理流程
start
:管理员登录店端管理系统;
:进入订单管理模块;
diamond "选择订单类型" as OrderType {
  -> 预约订单处理;
  -> 商品订单处理;
  -> 订单统计;
}

' 预约订单处理
if (预约订单处理) then (是)
  :查看预约订单列表;
  :选择待处理的预约订单;
  diamond "订单状态" as AppointmentStatus {
    -> 待确认;
    -> 已确认;
    -> 已完成;
    -> 已取消;
  }
  
  if (待确认) then (是)
    :查看预约详情;
    :确认预约;
    :系统更新订单状态为已确认;
    :通知用户预约已确认;
  else (否)
    if (已确认) then (是)
      :查看预约详情;
      :标记预约为已完成;
      :系统更新订单状态为已完成;
      :通知用户预约已完成;
    else (否)
      if (需要取消) then (是)
        :选择要取消的预约;
        :提交取消申请;
        :系统更新订单状态为已取消;
        :通知用户预约已取消;
      endif
    endif
  endif

' 商品订单处理
elseif (商品订单处理) then (是)
  :查看商品订单列表;
  :选择待处理的商品订单;
  diamond "订单状态" as ProductStatus {
    -> 待确认;
    -> 已确认;
    -> 已支付;
    -> 已发货;
    -> 已完成;
    -> 已取消;
  }
  
  if (待确认) then (是)
    :查看订单详情;
    :确认订单;
    :系统更新订单状态为已确认;
    :通知用户订单已确认;
  else (否)
    if (已支付) then (是)
      :查看订单详情;
      :安排商品发货;
      :系统更新订单状态为已发货;
      :通知用户商品已发货;
    else (否)
      if (已发货) then (是)
        :查看订单详情;
        :等待用户确认收货;
        :用户确认收货后系统更新订单状态为已完成;
      else (否)
        if (需要退款) then (是)
          :选择要退款的订单;
          :处理退款申请;
          :系统更新订单状态为已退款;
          :通知用户退款成功;
        endif
      endif
    endif
  endif

' 订单统计
elseif (订单统计) then (是)
  :选择统计时间范围;
  :选择统计类型;
  :系统生成订单统计报表;
  :查看统计结果;
  :导出统计数据;

endif

:订单处理流程结束;
stop

@enduml