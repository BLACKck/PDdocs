@startuml
' 游戏控制模块流程图
' 贪吃蛇游戏控制模块详细流程

title 游戏控制模块流程图

start
:初始化游戏控制模块;

' 开始游戏流程
partition "开始游戏" {
  :点击开始按钮;
  :重置分数为0;
  :初始化蛇的位置和方向;
  :生成初始食物;
  :设置游戏速度（根据当前难度）;
  :设置游戏状态为"进行中";
  :启动游戏循环;
}

' 暂停/继续流程
partition "暂停/继续" {
  if (游戏状态为"进行中"?) then (是)
    :点击暂停按钮;
    :设置游戏状态为"暂停";
    :停止游戏循环;
  else (否)
    if (游戏状态为"暂停"?) then (是)
      :点击继续按钮;
      :设置游戏状态为"进行中";
      :重新启动游戏循环;
    else (否)
      :无操作;
    endif
  endif
}

' 重新开始流程
partition "重新开始" {
  :点击重新开始按钮;
  :重置分数为0;
  :初始化蛇的位置和方向;
  :生成新的食物;
  :设置游戏速度（根据当前难度）;
  :设置游戏状态为"进行中";
  :启动游戏循环;
}

' 难度调整流程
partition "难度调整" {
  :选择难度级别（简单/中等/困难）;
  if (游戏正在进行中?) then (是)
    :立即更新游戏速度;
  else (否)
    :保存难度设置，游戏开始时生效;
  endif
}

stop
@enduml