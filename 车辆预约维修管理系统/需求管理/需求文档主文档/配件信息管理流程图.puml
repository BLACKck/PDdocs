@startuml
'配件信息管理流程图

title 配件信息管理流程

start

:登录店端系统;
:进入配件信息管理页面;
:查看配件列表;

if (需要操作?) then (是)
  if (操作类型?) then (添加)
    :添加配件信息;
    :填写配件详情;
    :提交保存;
  else if (编辑)
    :选择配件;
    :编辑配件信息;
    :保存更改;
  else if (删除)
    :选择配件;
    :确认删除;
    :删除配件信息;
  else if (入库)
    :选择配件;
    :填写入库数量和批次;
    :确认入库;
    :更新库存数量;
  else if (出库)
    :选择配件;
    :填写出库数量和用途;
    :确认出库;
    :更新库存数量;
  else (库存预警)
    :查看库存预警列表;
    :处理预警配件;
    :生成采购建议;
  endif
else (否)
  if (需要查询?) then (是)
    :输入查询条件;
    :执行查询;
    :查看查询结果;
  else (否)
    :返回;
  endif
endif

stop

@enduml