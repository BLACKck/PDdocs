@startuml
!define RECTANGLE class
!define CIRCLE ()
!define DIAMOND diamond
!define ARROW -->

' 系统整体流程图
rectangle "系统整体架构" as SystemOverview {
  rectangle "对客前端" as CustomerFrontEnd {
    rectangle "用户管理" as UserManagement
    rectangle "服务预约" as ServiceAppointment
    rectangle "宠物圈" as PetCircle
    rectangle "商品购买" as ProductPurchase
  }
  
  rectangle "店端管理系统" as StoreManagementSystem {
    rectangle "基础管理" as BasicManagement
    rectangle "宠物信息管理" as PetInfoManagement
    rectangle "商品管理" as ProductManagement
    rectangle "订单管理" as OrderManagement
    rectangle "帖子管理" as PostManagement
  }
  
  database "数据库" as Database
  cloud "云存储" as CloudStorage
}

' 对客前端流程
UserManagement --> ServiceAppointment : 预约服务
UserManagement --> PetCircle : 发布/查看帖子
UserManagement --> ProductPurchase : 购买商品

' 店端管理系统流程
BasicManagement --> PetInfoManagement : 管理宠物信息
BasicManagement --> ProductManagement : 管理商品
BasicManagement --> OrderManagement : 处理订单
BasicManagement --> PostManagement : 管理帖子

' 系统间数据流动
CustomerFrontEnd --> Database : 数据存储/读取
StoreManagementSystem --> Database : 数据存储/读取
CustomerFrontEnd --> CloudStorage : 文件存储
StoreManagementSystem --> CloudStorage : 文件存储

@enduml