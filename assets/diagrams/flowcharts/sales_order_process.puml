@startuml

skinparam backgroundColor #FFFFFF
skinparam activityFontSize 12
skinparam activityFontStyle bold
skinparam arrowFontSize 10

start
:客户下单;
:销售代表创建订单;
:订单审核;
diamond "审核结果" as auditResult
auditResult --> "通过" as passed
auditResult --> "拒绝" as rejected

rejected --> :订单修改;
:订单修改; --> :销售代表创建订单;

passed --> :订单确认;
:订单确认; --> :库存检查;
diamond "库存是否充足" as stockCheck
stockCheck --> "是" as stockYes
stockCheck --> "否" as stockNo

stockYes --> :安排发货;
stockNo --> :采购需求;
:采购需求; --> :采购流程;
:采购流程; --> :安排发货;

:安排发货; --> :订单发货;
:订单发货; --> :订单完成;
:订单完成; --> :订单归档;

stop

@enduml